# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json

# Jupyter
.ipynb_checkpoints/

# Environment / secrets — never let a connection string or token reach GitHub
.env
.env.*
secrets.json
*.pem
*.key
*.p12
credentials.json

# Databases. These hold real users' messages, so a stray copy in the repo would publish
# them. Ignored by extension rather than by name, because SQLITE_PATH can point anywhere.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Node.js dependencies
node_modules/

# Generated / local-only — not part of the app
*.xlsx
user_feedback.xlsx
backups/
